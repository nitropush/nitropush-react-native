{
  "name": "@nitropush/react-native",
  "version": "1.0.0-beta.3",
  "description": "Over-the-air updates for React Native and Expo with signed bundles, staged rollouts, rollback protection, and delta delivery.",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index",
  "source": "src/index",
  "scripts": {
    "build:plugin": "tsc -p tsconfig.plugin.json",
    "prepack": "yarn build:plugin",
    "test": "yarn build:plugin && yarn test:delta:golden && node --test test/security-source.test.mjs test/package-contents.test.mjs test/plugin-patching.test.mjs",
    "test:delta:golden": "cd test/delta-fixtures && shasum -a 256 -c SHA256SUMS && cd ../.. && bash ios/Tests/run-bspatch-golden.sh && bash android/src/test/native/run-bspatch-golden.sh",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf android/build node_modules/**/android/build lib nitrogen/generated",
    "codegen": "nitrogen --logLevel=\"debug\" && node post-script.js",
    "release": "release-it --preRelease=beta"
  },
  "keywords": [
    "react-native",
    "expo",
    "nitro",
    "nitropush",
    "codepush",
    "codepush-alternative",
    "over-the-air-updates",
    "ota"
  ],
  "files": [
    "app.plugin.js",
    "plugin/build/**/*",
    "src",
    "nitrogen/**/*",
    "nitro.json",
    "android/build.gradle",
    "android/fix-prefab.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src/**/*",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.c",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "*.podspec",
    "README.md"
  ],
  "homepage": "https://nitropush.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitropush/nitropush-react-native.git"
  },
  "author": "NitroPush",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "devDependencies": {
    "@types/react": "^19.1.3",
    "nitrogen": "0.37.0",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-nitro-modules": "0.37.0",
    "release-it": "^20.2.1",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.37.0"
  }
}
